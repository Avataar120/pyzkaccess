{
  "domain": "zkaccess_native",
  "name": "ZKAccess Native",
  "after_dependencies": [
    "frontend",
    "panel_custom",
    "persistent_notification"
  ],
  "categories": [
    "security_safety.locks_access"
  ],
  "codeowners": [
    "@Avataar120"
  ],
  "config_flow": true,
  "dependencies": [
    "http",
    "network",
    "websocket_api"
  ],
  "dhcp": [
    {
      "macaddress": "001761*"
    },
    {
      "registered_devices": true
    }
  ],
  "documentation": "https://github.com/Avataar120/pyzkaccess#home-assistant-integration",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/Avataar120/pyzkaccess/issues",
  "loggers": [
    "pyzkaccess_native"
  ],
  "requirements": [
    "pyzkaccess-native==0.5.1"
  ],
  "version": "0.5.1"
}
