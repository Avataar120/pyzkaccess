      }
    },
    "sync_clock": {
      "name": "Sync clock",
      "description": "Sets the device clock to Home Assistant's local time.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The ZKAccess device."
        }
      }
    },
    "list_users": {
      "name": "List users",
      "description": "Returns the users stored in the device.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The ZKAccess device."
        }
      }
    },
    "backup": {
      "name": "Backup",
      "description": "Saves users, fingerprint templates and authorizations to a JSON file in the zkaccess_native folder of the configuration directory.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The ZKAccess device."
        }
      }
    }
