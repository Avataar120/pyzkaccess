        "device_id": {
          "name": "Device",
          "description": "The ZKAccess device."
        },
        "pin": {
          "name": "PIN",
          "description": "User PIN (user number)."
        }
      }
    },
    "open_door": {
      "name": "Open door",
      "description": "Energizes the lock relay for a few seconds.",
