        "device_id": {
          "name": "Device",
          "description": "The ZKAccess device."
        },
        "pin": {
          "name": "PIN",
          "description": "User PIN (user number)."
        },
        "timezone": {
          "name": "Time zone",
          "description": "Time zone id (1 = always on factory devices)."
        },
        "doors": {
          "name": "Doors",
          "description": "Door bit mask: 1 = door 1, 2 = door 2, 4 = door 3, 8 = door 4."
        }
      }
    },
    "revoke": {
      "name": "Revoke access",
      "description": "Removes every door authorization of a user.",
