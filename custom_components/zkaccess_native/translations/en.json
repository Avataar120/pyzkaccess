{
  "config": {
    "step": {
      "user": {
        "title": "Connect to a ZKTeco device",
        "description": "PullSDK / ZKAccess device (C3, inBio, MA500...) reachable over TCP. Stop ZKAccess and any other program connected to the device first: it accepts a single session.",
        "data": {
          "host": "Host",
          "port": "Port",
          "password": "Communication password"
        },
        "data_description": {
          "host": "IP address of the device.",
          "password": "Leave empty if no communication password is set."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the device.",
      "invalid_auth": "Wrong communication password."
    },
    "abort": {
      "already_configured": "This device is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "poll_interval": "Real-time log polling interval (s)",
          "open_seconds": "Door open duration (s)",
          "sync_clock": "Set the device clock on connection"
        }
      }
    }
  },
  "entity": {
    "event": {
      "access": {
        "name": "Access",
