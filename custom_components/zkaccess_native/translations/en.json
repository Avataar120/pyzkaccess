          "name": "Device",
          "description": "The ZKAccess device."
        },
        "pin": {
          "name": "PIN",
          "description": "User PIN (user number)."
        },
        "name": {
          "name": "Name",
          "description": "Display name."
        },
        "card": {
          "name": "Card number",
          "description": "RFID card number."
        },
        "password": {
          "name": "Password",
          "description": "Keypad password (digits)."
        }
      }
    },
    "delete_user": {
      "name": "Delete a user",
      "description": "Deletes a user with its fingerprint templates and door authorizations.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The ZKAccess device."
        },
        "pin": {
          "name": "PIN",
          "description": "User PIN (user number)."
        }
      }
    },
    "grant": {
      "name": "Grant access",
      "description": "Allows a user to open doors during a time zone.",
